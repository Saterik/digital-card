generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?
  
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        String  @id @default(uuid())
  name      String
  profileId String
  
  profile   Profile @relation(fields: [profileId], references: [id])
  
  @@unique([name, profileId])
}

model Experience {
  id          String  @id @default(uuid())
  company     String
  position    String
  startDate   String
  endDate     String?
  achievements String
  
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  url         String?
  repository  String?
  
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id])
}